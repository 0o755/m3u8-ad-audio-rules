{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0o755/m3u8-ad-audio-rules/main/rule-schema.json",
  "title": "m3u8 Ad Audio Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "algorithm", "rules"],
  "properties": {
    "schemaVersion": {"const": 3},
    "revision": {"type": "integer", "minimum": 1},
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sampleRate", "windowMs", "hopMs", "bandCount"],
      "properties": {
        "id": {"const": "spectral-sequence-v3"},
        "sampleRate": {"const": 16000},
        "windowMs": {"const": 512},
        "hopMs": {"const": 256},
        "bandCount": {"const": 16}
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/rule"}
    },
    "testUrls": {
      "type": "object",
      "additionalProperties": {"type": "string", "format": "uri"}
    },
    "testPositionsMs": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationMs", "anchorOffsetMs", "anchorDurationMs", "fingerprints"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "durationMs": {"type": "integer", "minimum": 512},
        "anchorOffsetMs": {"type": "integer", "minimum": 0},
        "anchorDurationMs": {"type": "integer", "minimum": 512},
        "fingerprints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offsetMs", "hashes"],
            "properties": {
              "offsetMs": {"type": "integer"},
              "hashes": {
                "type": "array",
                "minItems": 4,
                "maxItems": 128,
                "items": {"type": "string", "pattern": "^[0-9a-fA-F]{8}$"}
              }
            }
          }
        }
      }
    }
  }
}
